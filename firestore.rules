rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUserDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myRole() {
      return exists(myUserDocPath()) ? get(myUserDocPath()).data.role : null;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isModeratorOrAdmin() {
      return signedIn() && (myRole() == 'moderator' || myRole() == 'admin');
    }

    function isProfiler() {
      return signedIn() && myRole() == 'profiler';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isModeratorOrAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /profiler/profiling/{productionType}/{implementationType}/records/{recordId} {
      allow read: if signedIn() &&
        (resource.data.createdBy == request.auth.uid || isModeratorOrAdmin());

      allow create: if isProfiler() && request.resource.data.createdBy == request.auth.uid;

      allow update: if (isProfiler() && resource.data.createdBy == request.auth.uid) ||
        isModeratorOrAdmin();

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
